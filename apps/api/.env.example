# Copy to apps/api/.env. Never send keys in chat or commit this file.
DATABASE_URL=postgresql+psycopg://personal_agent:CHANGE_ME@127.0.0.1:5432/personal_agent
# Region must match your API key. Beijing example; confirm in your console.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
EXTRACT_MODEL=qwen-flash
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3-rerank
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# Search adapter uses the account's supported Qwen enable_search capability.
SEARCH_MODEL=qwen-plus
SEARCH_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
# Same random value as AGENT_API_TOKEN in apps/web/.env.local. Backend only.
API_TOKEN=
OWNER_ID=local-user
STORAGE_DIR=.data
AUTO_MIGRATE=true
WORKER_ENABLED=true
